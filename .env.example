# Only DASHBOARD_* and SESSION_SECRET are actually required to boot the app.
# Everything Proxmox-related below is now OPTIONAL -- it's just a bootstrap
# default for first boot. The real, current values live in a settings file
# on the LABS_DIR volume (0600 perms, never committed) once you save them
# through the in-app Settings page, and take effect immediately without a
# restart.

# --- Dashboard auth (required) ------------------------------------------------
DASHBOARD_USERNAME=admin
# bcrypt hash of the login password -- generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
DASHBOARD_PASSWORD_HASH=
# Random string for signing session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Misc ----------------------------------------------------------------------
PORT=8080
LABS_DIR=/labs

# --- Proxmox connection (optional bootstrap default, configurable in-app) ---
PROXMOX_HOST=https://192.168.1.10:8006
PROXMOX_NODE=pve
# Create a scoped API token in Datacenter > Permissions > API Tokens, ideally
# against a dedicated user/role rather than root@pam, e.g.:
#   pveum user add labber-pve@pve
#   pveum aclmod / -user labber-pve@pve -role PVEAdmin
#   pveum user token add labber-pve@pve labber-pve-token --privsep 0
# PVEAdmin, not PVEVMAdmin -- the latter only covers VM operations, not the
# Sys.Modify permission that bridge create/delete (network-manager.js) AND
# storage create (template-builder.js's "new disk storage" flow) need on the
# node itself.
PROXMOX_TOKEN_ID=labber-pve@pve!labber-pve-token
PROXMOX_TOKEN_SECRET=
# false only for a self-signed homelab cert -- keep true anywhere the PVE
# cert is real/trusted.
PROXMOX_VERIFY_TLS=false

# Console access (termproxy/vncwebsocket) only -- Proxmox has a confirmed
# bug where API tokens aren't accepted for this one endpoint category
# (bugzilla #6079), even though the token above works for everything else
# in this app. A real username+password, not another token.
PROXMOX_USERNAME=
PROXMOX_PASSWORD=

# Proxmox storage ID where golden templates + lab clone disks live, e.g. a
# directory storage carved out on a dedicated SSD -- see README's "Disk
# storage" section. Leave empty to let Proxmox default to wherever clones/
# templates would otherwise land.
PROXMOX_DISK_STORAGE=

# --- Vendor golden templates (optional bootstrap default, configurable in-app) ---
TEMPLATE_ID_PALOALTO_PANOS=
TEMPLATE_ID_PALOALTO_PANORAMA=
TEMPLATE_ID_CHECKPOINT_GAIA=
TEMPLATE_ID_F5_BIGIP_VE=
TEMPLATE_ID_FORTIOS=
TEMPLATE_ID_FORTIMANAGER=
TEMPLATE_ID_CISCO_N9KV=
TEMPLATE_ID_CISCO_C8000V=
TEMPLATE_ID_CISCO_FTD=
TEMPLATE_ID_CISCO_FMC=

# --- Embedded GUI proxy (optional -- see README's "Node mgmt IP + browser
# access to a node's web UI" section) --------------------------------------
# Port for lib/gui-proxy.js's second HTTP listener (Host-header-routed
# reverse proxy for the dashboard's "embed" button). Needs a wildcard DNS
# record + reverse-proxy/Ingress rule for *.<GUI_DOMAIN> pointing at this
# port, set up outside this app.
GUI_PROXY_PORT=8081
# e.g. gui.labber.example.com -- same value as Settings' "GUI domain" field
# (this is just the optional bootstrap default, same pattern as everything
# else in this file).
GUI_DOMAIN=

# --- Security (optional) ---

# Set to 1 when this runs behind exactly one reverse proxy. Two effects:
# X-Forwarded-For/X-Real-IP become trustworthy (the login throttle and the
# public-stats IP allowlist both read them), and the session cookie marks
# itself Secure automatically on HTTPS. Leave unset when reachable
# directly, otherwise a client can spoof its own source IP.
TRUST_PROXY=

# Failed logins per source IP before a temporary lockout, and how long
# that lockout lasts. Defaults: 10 attempts, 10 minutes.
LOGIN_MAX_ATTEMPTS=
LOGIN_LOCKOUT_MINUTES=
